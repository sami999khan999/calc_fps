{
  "manifest_version": 3,
  "name": "FPS Meter",
  "version": "1.0.0",
  "description": "A per-tab FPS counter with a calculator-style LCD display. Toggle it with a keyboard shortcut, drag it anywhere, and it snaps to the edge and remembers its spot.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FPS Meter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
